# Sunucu
HOST=0.0.0.0
PORT=5173
# Istemci IP'si nereden okunur: none | cloudflare | forwarded (Caddy, Nginx)
TRUST_PROXY=forwarded

# Alan adi: Caddy HTTPS sertifikasini bununla alir
API_DOMAIN=api.ornek.com

# Saglayicilar: kendi sunucumuza gecince sadece bu adresler degisir
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_DELAY_MS=1100
BROUTER_URL=https://brouter.de

# Dakikalik kullanim sinirlari (IP basina)
RATE_GEOCODE=10
RATE_ROUTE=30
RATE_REPORTS=5
RATE_DEFAULT=120
